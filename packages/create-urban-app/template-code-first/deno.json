{
	"tasks": {
		"typecheck": "deno check main.ts 'workflows/**/*.ts' 'scripts/**/*.ts'",
		"lint": "deno run -A npm:@biomejs/biome check",
		"check": "deno run -A npm:@nanobpm/urban@^0.24.0 check",
		"gen": "deno run -A npm:@nanobpm/urban@^0.24.0 gen",
		"gen:check": "deno run -A npm:@nanobpm/urban@^0.24.0 gen --check",
		"start": "deno run -A main.ts",
		"dev": "deno run -A --watch main.ts",
		"greet": "deno run -A scripts/greet.ts"
	},
	"imports": {
		"@nanobpm/urban": "npm:@nanobpm/urban@^0.24.0"
	},
	"nodeModulesDir": "auto"
}
