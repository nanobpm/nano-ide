{
  "tasks": {
    "check": "deno run -A npm:@nanobpm/urban@^0.31.0 check",
    "gen": "deno run -A npm:@nanobpm/urban@^0.31.0 gen",
    "gen:check": "deno run -A npm:@nanobpm/urban@^0.31.0 gen --check",
    "start": "deno run -A main.ts",
    "dev": "deno run -A --watch main.ts",
    "greet": "deno run -A scripts/greet.ts",
    "test": "deno test -A tests/"
  },
  "imports": {
    "@nanobpm/urban": "npm:@nanobpm/urban@^0.31.0",
    "@nanobpm/urban-testkit": "npm:@nanobpm/urban-testkit@^0.1.0"
  },
  "nodeModulesDir": "auto"
}
