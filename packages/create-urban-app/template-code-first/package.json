{
	"name": "__APP_ID__",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "__APP_NAME__ — a code-first Urban app.",
	"engines": {
		"node": ">=22.6"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"check": "urban check",
		"gen": "urban gen",
		"gen:check": "urban gen --check",
		"start": "node --experimental-strip-types main.ts",
		"dev": "node --watch --experimental-strip-types main.ts",
		"greet": "node --experimental-strip-types scripts/greet.ts",
		"test": "node --test --experimental-strip-types \"tests/**/*.test.ts\""
	},
	"dependencies": {
		"@nanobpm/urban": "^0.77.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@nanobpm/urban-testkit": "^0.12.11",
		"@types/node": "^22.0.0",
		"typescript": "^5.6.0"
	}
}
