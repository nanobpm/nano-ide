{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"packages/*/src/**/*.ts",
			"packages/urban/src/runtime/browser/**/*.js",
			"packages/connector-slack/*.ts",
			"packages/trigger-mqtt/*.ts",
			"!**/node_modules/**",
			"!**/dist/**",
			"!**/*.d.ts"
		]
	},
	"formatter": { "enabled": false },
	"assist": { "enabled": false },
	"linter": {
		"enabled": true,
		"rules": { "preset": "none" }
	},
	"plugins": ["./plugins/no-unsafe-type-assertion.grit"]
}
