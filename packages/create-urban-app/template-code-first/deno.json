{
	"tasks": {
		"typecheck": "deno check main.ts \"workflows/**/*.ts\" \"scripts/**/*.ts\"",
		"lint": "deno run -A npm:@biomejs/biome@2.5.10 check",
		"check": "deno run -A npm:@nanobpm/urban@^0.77.2 check",
		"gen": "deno run -A npm:@nanobpm/urban@^0.77.2 gen",
		"gen:check": "deno run -A npm:@nanobpm/urban@^0.77.2 gen --check",
		"start": "deno run -A main.ts",
		"dev": "deno run -A --watch main.ts",
		"greet": "deno run -A scripts/greet.ts",
		"test": "deno test -A tests/"
	},
	"imports": {
		"@nanobpm/urban": "npm:@nanobpm/urban@^0.77.2",
		"@nanobpm/urban-testkit": "npm:@nanobpm/urban-testkit@^0.12.11"
	},
	"nodeModulesDir": "auto"
}
